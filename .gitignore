# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
library-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/

# .build-kit/ is mostly the loop the CLI installs (its JS and node_modules):
# version only the blueprint, the learnings and the prompts, which are yours.
# This example also versions the model it was built from (`fetch --context`),
# so the scenario guard has something to check in a fresh clone.
.build-kit/*
!.build-kit/CLAUDE.md
!.build-kit/AGENTS.md
!.build-kit/.slices/
!.build-kit/lib/
.build-kit/lib/*
!.build-kit/lib/*.md
!.build-kit/lib/check-commit-scope.cjs


# The FACT event store and any other runtime data. Never version controlled:
# it is environment state, not project state.
/data/

# eventmodelers credentials (token): never version controlled
.eventmodelers/

# Installed by `npx @eventmodelers/cli init`, under the CLI's own licence
# (CC BY-NC 4.0): not part of this repo. The build-* skills are the kit's.
/CLAUDE.md
/.claude/skills/comic/
/.claude/skills/connect/
/.claude/skills/learn-eventmodelers-api/
/.claude/skills/load-slice/
/.claude/skills/request-feedback/
/.claude/skills/ui-contract/
/.claude/skills/update-slice-status/
